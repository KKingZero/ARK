server: "127.0.0.1:50051"
cert: "~/.ark/certs/operator.pem"
key: "~/.ark/certs/operator-key.pem"
ca: "~/.ark/certs/ca.pem"
# Dual-control seat for in-TUI / in-process Approve/Deny (different CN from operator).
# Created by `ark serve` alongside operator certs.
approver_cert: "~/.ark/certs/approver.pem"
approver_key: "~/.ark/certs/approver-key.pem"
llm:
  # Console `ai` uses ~/.ark/llm.yaml (multi-provider). Override here for agent sidecar only.
  base_url: "http://localhost:11434/v1"
  api_key: "ollama"
  model: "llama3.2"
autonomy:
  max_steps: 50
  auto_approve: false